{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"skipLibCheck": true,
		"strict": false
	},
	"include": ["*.js", "modules/**/*.js", "scripts/**/*.js", "examples/**/*.js", "apps/**/*.js"],
	"exclude": ["node_modules", ".work"]
}
