{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"skipLibCheck": true,
		"strict": false
	},
	"include": [
		"*.js",
		"modules/**/*.js",
		"scripts/**/*.js",
		"examples/**/*.js",
		"apps/**/*.js",
		"apps/client/browser-modules.d.ts"
	],
	"exclude": ["node_modules", ".work"]
}
